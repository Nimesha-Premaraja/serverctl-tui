/* ===================================================================
   ServerCtl — System Monitor
   Professional dashboard theme
   =================================================================== */

Screen {
    background: $background;
}

#dashboard {
    height: 1fr;
    padding: 1 2;
}

/* --- Metric cards ------------------------------------------------- */

#stats {
    height: auto;
    margin-bottom: 1;
}

.metric-card {
    width: 1fr;
    height: auto;
    padding: 1 2;
    margin-right: 2;
    border: round $primary 30%;
    background: $panel;
}

.metric-card:last-of-type {
    margin-right: 0;
}

.metric-title {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 1;
}

.metric-value {
    width: auto;
    color: $success;
}

.metric-value.healthy {
    color: $success;
}

.metric-value.warning {
    color: $warning;
}

.metric-value.critical {
    color: $error;
}

.metric-detail {
    color: $text-muted;
    margin-top: 1;
}

/* Progress bars ---------------------------------------------------- */

ProgressBar {
    width: 100%;
    margin-top: 1;
}

ProgressBar > Bar {
    width: 100%;
}

ProgressBar.healthy > Bar > .bar--bar {
    color: $success;
}

ProgressBar.warning > Bar > .bar--bar {
    color: $warning;
}

ProgressBar.critical > Bar > .bar--bar {
    color: $error;
}

/* --- Info panels -------------------------------------------------- */

#panels {
    height: 1fr;
    min-height: 12;
}

.panel {
    border: round $primary 30%;
    background: $panel;
    padding: 1 2;
    height: 100%;
}

#system-panel {
    width: 3fr;
    margin-right: 2;
}

#network-panel {
    width: 2fr;
}

.panel-title {
    text-style: bold;
    color: $accent;
    border-bottom: heavy $primary 20%;
    width: 100%;
    margin-bottom: 1;
    padding-bottom: 0;
}

.panel-body {
    color: $text;
}

/* --- Status bar --------------------------------------------------- */

#status-bar {
    height: 3;
    background: $panel;
    border: round $primary 30%;
    padding: 0 2;
    margin-top: 1;
    content-align: left middle;
}

#status-indicator {
    width: auto;
    color: $success;
    text-style: bold;
    content-align: left middle;
    height: 100%;
}

#status-updated {
    width: 1fr;
    color: $text-muted;
    content-align: center middle;
    height: 100%;
}

#status-hints {
    width: auto;
    color: $text-muted;
    content-align: right middle;
    height: 100%;
}
